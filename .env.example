# Shopify (filled by `shopify app config link` / Partner Dashboard)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders,unauthenticated_read_content,read_products,read_themes,read_files,read_locations,read_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders

# Postgres (Neon via the Vercel Marketplace, which sets both). DATABASE_URL
# = pooled host, DATABASE_URL_UNPOOLED = direct host, used by `prisma
# migrate`. Local dev: docker container on 55450, same URL for both.
DATABASE_URL=postgresql://postgres:postgres@localhost:55450/weather_slip
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:55450/weather_slip

# Weather. Default provider is OpenWeather (free plan: 1M calls/month,
# 60/min, 5-day forecast). Comma-separated keys from ONE account: later keys
# are only used when an earlier one is rejected (401), never to dodge a 429.
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEYS=
# Only if WEATHER_PROVIDER=open-meteo (free endpoint is non-commercial).
OPEN_METEO_API_KEY=

# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts merchants'
# own API keys at rest — rotating it makes saved keys unreadable.
ENCRYPTION_KEY=

# Vercel Cron (daily) and the GitHub Actions workflow (every 10 min) send
# `Authorization: Bearer $CRON_SECRET` to /api/cron/drain.
CRON_SECRET=

# Operator alert emails (app/lib/alerts.server.ts). Without these, alerts
# are only logged. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
